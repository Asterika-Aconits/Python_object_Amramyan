#задание 2
#дан список размера N. Найти номера тех элементов списка, которые больше своего
#правого соседа, и количество таких элементов. найденные номера выводить
#в порядке их возрастания.
import random #импортирует библеотеку рандом

lis_t = [] #список
elements = [] #список где будут индексы элементов
while True: #цикл который следит за правильностью ввода цикла
  try:
    n = int(input("сколько элементов в списке нужно?"))
    if n > 0:
      break
    else:
      print("значение должно быть больше 0")
  except ValueError:
    print("Вы ввели неправильное значение")
    continue

for i in range(n): #заполняет список рандом значениями
  lis_t.append(random.randint(1,100))
  print(i, ": " ,lis_t[i])

for i in range(n - 1): #цикл проверки значений.n-1 чтоб в конце правильно работало
  if lis_t[i] > lis_t[i+1]: # проверяет больше ли значения что справа
    elements.append(i)

print("индексы чисел: ")
for i in range(len(elements)): #цикл вывода элементов
  print(elements[i])
  
