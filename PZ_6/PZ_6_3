#задание 3
#Дан список А размера N и целые числа K и L(1 < K < L < N) переставить в 
#обратном порядке элементы списка расположенные между элементами Ak и Al,
#не включая эти элементы
import random

list_A = [] #создание списка А
while True: #проверка правильности значений
  try:
    n = int(input("сколько элементов в списке нужно?"))
    if n > 0:
      break
    else:
      print("значение должно быть больше 0")
  except ValueError:
    print("Вы ввели неправильное значение")
    continue

for i in range(n): #наполнется список до нужного размера
  list_A.append(random.randint(1,100))
  print(i, ": " ,list_A[i])

while True: #проверка ввода индекса к
  try:
    k = int(input("какой индекс вы берете для K?"))
    if k > 1:
      break
    else:
      print("значение должно быть больше 1")
  except ValueError:
    print("Вы ввели неправильное значение")
    continue

while True: #проверка ввода индекса л
  try:
    l = int(input("какой индекс вы берете для L?")) #л должно быть больше к
    if l > k:
      break
    else:
      print("значение должно быть больше K")
  except ValueError:
    print("Вы ввели неправильное значение")
    continue

list_temp = [] #список где мы поставим новые значения
for i in range(n):
  list_temp.append(list_A[i]) #пока что просто копируем предыдуший список

iter = k + 1 #счет итераций от значения к 
temp = 1 #временное мусорное значение
while iter < l:
  list_temp[iter] = list_A[l - temp]#в начала списка от к выводит конец от л
  iter += 1
  temp += 1

for i in range(n): #вывод нового списка с его индексами
  print(i, ": " ,list_temp[i])
