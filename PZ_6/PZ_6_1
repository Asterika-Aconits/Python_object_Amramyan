#задание 1
#сформировать и вывести целочисленный список размера 10, содержащий 10 первых
#положительных нечетных чисел

negativ = [] #создание списка
number = 1
for i in range(10): #цикл заполнение списка
  negativ.append(number) #добавляет элемент в список
  print(negativ[i]) #сразу вывыодит по жлементу в индексе i
  number += 2
