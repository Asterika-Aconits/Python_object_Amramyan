#Даны координаты точки, не лежащей на координатных осях OX и OY.
#Определить номер координатной четверти, в которой находится данная точка.
while True: #работает пока значение неправильное
  try:
    x = int(input("Х:"))
    break #выводит с цикла при правильном значении
  except ValueError: #в случаи если ввели число
    print("Ошибка: вы ввели неправильное значение")

while True: #работает пока значение неправильное
  try:
    y = int(input("Y:"))
    break #выводит с цикла
  except ValueError:
    print("Ошибка: вы ввели неправильное значение")

#начинает искать четверти методом перебора положительная или отрицательная координата
if x > 0 and y > 0:
  print("Вы на 1 четверти")
elif x < 0 and y > 0:
  print("Вы на 2 четверти")
elif x < 0 and y < 0:
  print("Вы на 3 четверти")
elif x > 0 and y < 0:
  print("Вы на 4 четверти")
elif x == 0 and y != 0: #в случаи если одна х = 0
  print("Вы на Y кординатах")
elif x != 0 and y == 0: #в слечаи если у= 0
  print("Вы на Х кординатах")
else: #если оба равны 0
  print("Вы на 0 точке")
