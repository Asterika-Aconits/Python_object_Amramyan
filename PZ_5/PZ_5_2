#Описать функцию PowerA234(параметры), вычисляющую вторую, третью и четвертую
#степень числа А и возвращающую эти степени соответственно в переменные B,C и
#D. С помощью этой функции найди вторую, третью и четвертую степень пяти
#данных чисел.
def PowerA234(number):#функция считающая степени
  b = number ** 2
  c = number ** 3
  d = number ** 4
  return b, c, d
  #возвращяет все значения через запятую из-за чего те пойдут в разные переменные

number = int(input("введите число: "))
b, c, d = PowerA234(number) #назначение трех переменных чтобы принять все значения
print ("во второй степени:", b)
print ("в третьей степени:", c)
print ("в четвертой степени:", d)
