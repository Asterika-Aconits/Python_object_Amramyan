#Составить функцию решения задачи: из заданного числа вычли сумму его цифр.
#Из результата вновь вычли сумму его цифр и т.д. Через сколько таких действий
#получится ноль
def cifer(number): #функция считает и выводит сумму цифр
  summ = 0
  while number > 0:
    summ += number % 10
    number //= 10
  return summ

while True:
  try:
    number = int(input("Введите число:"))
    break
  except ValueError:
    print("вы ввели неправильное значение")

i = 0 #это считает количество итераций
while number > 0: #работает пока число не стало 0
  number -= cifer(number) # дает функции значение числа и сразу выводит его
  i += 1

print(i)
