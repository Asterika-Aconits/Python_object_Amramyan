#Дано целое число A. Проверить истинность высказывания: «Число A является положительным».
#вариант 1
# часть 1
while True: #работает пока не введут правильное значение
  try: #принимает введенное значение
    number = int(input("Пожалуйста введите число: "))
    break #выводит если значение правильное
  except ValueError: #в случае если ввели буквы
    print("неправильное значение")

if number > 0: #вычесляет положительное ли число
  print(f"число {number} положительное")
elif number == 0: #проверяет равен ли нулю
  print(f"число {number} ноль")
else: #все остальное бдет являться отрицательными числами
  print(f"число {number} отрицательное")
