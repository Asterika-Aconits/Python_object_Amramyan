while True: #перебирает значения ища правильное
  try:
    number = int(input("введите целое число:"))
    if number % 1:
      print("не целое число")
      continue
    break
  except ValueError:
    print("Неправильное значение")

if number > 0: # положительное
  number += 20
elif number < 0: #отрицательное
  number -= 5
else: #равен 0 в ином случаи
  print("значение 0")

print(number)
