while True: #перебирает значения до правильного
  try:
    number = int(input("введите двухзначное число:"))
    if number >= 100 or number < 10: #если больше 100 то не двухзначное число, меньше значит однозначное
      print("не двухзначное число")
      continue
    break
  except ValueError:
    print("Неправильное значение")
  
a = number % 10 #выявляет первое значение из единиц
b = number % 100 // 10 #выявляет второе значение из десятков
summ = a * b
if summ % 2:#если 1 то нечетное
  number / 2
else:
  number * 2

print(number)
